#!/bin/sh
set -eu
if [ -d /usr/bin ]; then PATH="/usr/bin:$PATH"; export PATH; fi

repo_root=$(git rev-parse --show-toplevel)
scanner="$repo_root/scripts/check_staged_secrets.py"

if command -v python >/dev/null 2>&1; then
    exec python "$scanner" --pre-push
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$scanner" --pre-push
elif command -v py >/dev/null 2>&1; then
    exec py -3 "$scanner" --pre-push
fi

echo "Push blocked: Python is required for the commit-history secret check." >&2
exit 2
