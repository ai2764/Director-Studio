# Local service configuration. Source checkouts copy this file to backend/.env;
# the Windows portable build publishes it as .env beside DirectorStudio.exe.
DS_COMFY_BASE_URL=http://127.0.0.1:8188
DS_HOST=127.0.0.1
DS_PORT=8790

DS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Director LLM provider: enable exactly one of ollama (default), lm-studio,
# or openai-compatible. The model is discovered and selected in the UI.
DS_LLM_PROVIDER=ollama
# LM Studio: DS_LLM_BASE_URL=http://127.0.0.1:1234/v1
# OpenAI: DS_LLM_BASE_URL=https://api.openai.com/v1
# Local llama.cpp example: DS_LLM_BASE_URL=http://127.0.0.1:8080/v1
# DS_LLM_API_KEY=replace-with-a-real-secret
# DS_LLM_TIMEOUT_SEC=600

DS_POLL_INTERVAL_SEC=1.5
DS_JOB_TIMEOUT_SEC=1800
DS_MAX_UPLOAD_MB=20

# H3 video provider: local (ComfyUI through official Comfy MCP, default) or
# minimax (official V2 API).
DS_H3_PROVIDER=local
# MCP transports every local ComfyUI image/video workflow. The default commands
# are installed by backend/requirements.txt.
# DS_COMFY_MCP_COMMAND=comfy-mcp
# DS_COMFY_MCP_ARGS=
# DS_COMFY_MCP_COMFY_BIN=comfy
# Set the secret only in backend/.env or as MINIMAX_API_KEY; never commit it.
# MINIMAX_API_KEY=your-secret-key
# DS_H3_MINIMAX_API_KEY=your-secret-key
DS_H3_MINIMAX_MODEL=MiniMax-H3
DS_H3_MINIMAX_RESOLUTION=768P
DS_H3_MINIMAX_POLL_INTERVAL_SEC=10
DS_H3_MINIMAX_TIMEOUT_SEC=3600
DS_H3_MINIMAX_MAX_GET_RETRIES=3
DS_H3_MINIMAX_RETRY_DELAY_SEC=2
