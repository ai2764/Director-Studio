# Local service configuration. Source checkouts copy this file to backend/.env;
# Portable builds publish it as .env beside the DirectorStudio executable.
DS_COMFY_BASE_URL=http://127.0.0.1:8188
# Layout generation shares the H3 ComfyUI instance unless explicitly overridden.
DS_QWEN_IMAGE_21_COMFY_BASE_URL=
DS_HOST=127.0.0.1
DS_PORT=8790

DS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Director LLM provider: enable exactly one of ollama (default), lm-studio,
# or openai-compatible. The model is discovered and selected in the UI.
# OpenAI-compatible services may report the selected model's serving context in
# GET /v1/models as meta.n_ctx (a positive integer). Director uses it for context
# budgeting and compaction; absent/invalid metadata or discovery errors keep
# DS_DIRECTOR_NUM_CTX as the fallback (default 32768). Report the configured serving
# window, not the model's theoretical maximum.
DS_LLM_PROVIDER=ollama
# LM Studio: DS_LLM_BASE_URL=http://127.0.0.1:1234/v1
# OpenAI: DS_LLM_BASE_URL=https://api.openai.com/v1
# Local llama.cpp example: DS_LLM_BASE_URL=http://127.0.0.1:8080/v1
# DS_LLM_API_KEY=replace-with-a-real-secret
# DS_LLM_TIMEOUT_SEC=600
# Output token budget, not a retry count. Includes reasoning on some servers.
# Prompt writing and review reserve the larger of this value and their stage budget.
# DS_DIRECTOR_NUM_PREDICT=4096

DS_POLL_INTERVAL_SEC=1.5
DS_JOB_TIMEOUT_SEC=1800
DS_MAX_UPLOAD_MB=20

# H3 video provider: local (ComfyUI through official Comfy MCP, default) or
# minimax (official V2 API).
DS_H3_PROVIDER=local
# MCP transports every local ComfyUI image/video workflow. Source installs get
# these commands from backend/requirements.txt. Windows portable uses its bundled
# private Python/MCP runtime when all three settings below remain commented.
# Explicit values override the portable bundle.
# DS_COMFY_MCP_COMMAND=comfy-mcp
# DS_COMFY_MCP_ARGS=
# DS_COMFY_MCP_COMFY_BIN=comfy
# Set the secret only in backend/.env or as MINIMAX_API_KEY; never commit it.
# MINIMAX_API_KEY=your-secret-key
# DS_H3_MINIMAX_API_KEY=your-secret-key
DS_H3_MINIMAX_MODEL=MiniMax-H3
DS_H3_MINIMAX_RESOLUTION=768P
DS_H3_MINIMAX_POLL_INTERVAL_SEC=10
DS_H3_MINIMAX_TIMEOUT_SEC=3600
DS_H3_MINIMAX_MAX_GET_RETRIES=3
DS_H3_MINIMAX_RETRY_DELAY_SEC=2
# Default Director Agent loop. Python retains all business state and model routing.
# Launch with .\start.ps1; legacy is available only as an explicit compatibility choice.
DS_DIRECTOR_AGENT_RUNTIME=harness
# Portable packages start their bundled sidecar by default. Set false only for an external sidecar.
# DS_HARNESS_MANAGED=true
# start.ps1 supplies the loopback URL and per-worktree internal token automatically.
DS_HARNESS_BASE_URL=http://127.0.0.1:8791
DS_HARNESS_MAX_STEPS=12
# Separate per-turn tool admission budget; includes argument/state rejections (1-64).
DS_HARNESS_MAX_TOOL_CALLS=64
DS_HARNESS_TURN_TIMEOUT_SEC=1800

# ---- Launcher / runtimes (all optional; Settings writes these for you) -------------
# Start everything with the DS launcher: `python -m app.launcher run [--open]` (source)
# or `./director-studio` (installed package). It supervises the Harness sidecar and the
# backend and powers the "Restart now" button. Installed packages keep this file in
# $DS_HOME (default ~/.local/share/DirectorStudio/.env).
#
# ComfyUI: managed (DS starts its own ComfyUI) | external-local | remote
# DS_COMFY_MODE=external-local
# DS_COMFY_DIR=                 # managed: ComfyUI folder (default <install>/runtime/ComfyUI)
# DS_COMFY_MODELS_DIR=          # managed: models folder (default <data dir>/models), see docs/models.md
# DS_COMFY_REMOTE_URL=          # remote: e.g. https://comfy.example.com
# DS_COMFY_REMOTE_AUTH_TYPE=none  # none|bearer|basic|headers; secret in DS_COMFY_REMOTE_AUTH
# DS_VRAM_SHARED_GPU=auto       # auto|true|false: LLM and ComfyUI on one GPU -> unload the LLM
#                               # before generation, /free ComfyUI before LLM turns (remote too).
#                               # Set true when llama-swap/Ollama and a remote ComfyUI share a PC.
#
# Director LLM: DS_LLM_PROVIDER=ollama|lm-studio|llama-swap|openai-compatible
# Ollama: system = your own Ollama at DS_OLLAMA_BASE_URL; bundled = DS's private Ollama
# (random loopback port, models in <data dir>/ollama/models, context = DS_DIRECTOR_NUM_CTX).
# DS_OLLAMA_MODE=system
# DS_OLLAMA_DIR=                # bundled: Ollama folder (default <install>/runtime/ollama)
# DS_OLLAMA_MODELS_DIR=
# DS_OLLAMA_PORT=0              # 0 = pick a free port
# DS_DIRECTOR_NUM_CTX=32768
#
# FFmpeg/ffprobe lookup: DS_FFMPEG_DIR, then <install>/runtime/ffmpeg/bin, then PATH.
# DS_FFMPEG_DIR=
#
# Remote access: DS has no login. Keep DS_HOST=127.0.0.1 and use Tailscale
# (`tailscale serve --bg 8790`) or an SSH tunnel; see docs/installer.md.
